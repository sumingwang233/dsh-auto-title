{
  "name": "dsh-auto-title",
  "version": "0.1.0",
  "description": "Automatic session titles for DeepSeek Harness: names a session from the first prompt plus the first assistant reply (\"project｜task\") instead of truncating the prompt into the taskbar.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-title",
    "rename"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "sumingwang233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumingwang233/dsh-auto-title.git"
  },
  "homepage": "https://github.com/sumingwang233/dsh-auto-title#readme",
  "bugs": {
    "url": "https://github.com/sumingwang233/dsh-auto-title/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/core.test.js test/host.test.js test/manual.test.js test/settings.test.js test/log.test.js test/client.test.js"
  }
}
